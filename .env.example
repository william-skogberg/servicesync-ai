# Copy to .env and change values for your local environment.
# NEVER commit the real .env file or API keys.
# Demo mode uses deterministic rules and does not call the OpenAI API.
AI_MODE=demo
OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=

# Two local services: mock CRM + inquiry API.
CRM_URL=http://127.0.0.1:8001/leads
CRM_API_TOKEN=local-demo-token
INQUIRY_DB=data/inquiries.db
CRM_DB=data/crm.db
